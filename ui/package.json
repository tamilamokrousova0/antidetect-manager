{
  "name": "antidetect-manager-ui",
  "version": "0.2.3",
  "private": true,
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "bundle": "node build/make-bundle.js --platform mac",
    "bundle:win": "node build/make-bundle.js --platform win",
    "dist": "electron-builder --mac dir --arm64",
    "dist:dmg": "electron-builder --mac dmg zip --arm64",
    "dist:win": "node build/dist-win.js"
  },
  "devDependencies": {
    "electron": "45.0.0",
    "electron-builder": "^26.18.0"
  },
  "productName": "Antidetect Manager",
  "description": "Профили Camoufox: отпечатки, прокси, cookies",
  "build": {
    "appId": "local.antidetect-manager",
    "productName": "Antidetect Manager",
    "electronVersion": "45.0.0",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "preload.js",
      "index.html",
      "renderer.js",
      "style.css"
    ],
    "mac": {
      "target": [
        {
          "target": "dir",
          "arch": [
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.icns",
      "category": "public.app-category.productivity",
      "identity": null,
      "extendInfo": {
        "NSAppleEventsUsageDescription": "Чтение списка шрифтов системы для профилей macOS."
      },
      "extraResources": [
        {
          "from": "bundle-mac",
          "to": "adm"
        }
      ]
    },
    "afterPack": "build/afterpack.js",
    "artifactName": "Antidetect-Manager-${version}-${arch}.${ext}",
    "dmg": {
      "title": "Antidetect Manager",
      "contents": [
        {
          "x": 140,
          "y": 180
        },
        {
          "x": 420,
          "y": 180,
          "type": "link",
          "path": "/Applications"
        }
      ],
      "window": {
        "width": 560,
        "height": 380
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "extraResources": [
        {
          "from": "bundle-win",
          "to": "adm"
        }
      ],
      "artifactName": "Antidetect-Manager-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Antidetect-Manager-Setup-${version}-win-${arch}.${ext}",
      "shortcutName": "Antidetect Manager"
    }
  }
}
